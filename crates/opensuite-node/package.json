{
  "name": "@opensuitehq/engine",
  "version": "0.1.1",
  "description": "OpenSuite native DOCX engine (N-API). Platform binaries ship as optionalDependencies.",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamshivakhatri/opensuite-engine.git"
  },
  "license": "MIT OR Apache-2.0",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "opensuite_node",
    "packageName": "@opensuitehq/engine",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "node ./scripts/build-native.mjs",
    "build:debug": "node ./scripts/build-native.mjs --debug",
    "create-npm-dirs": "napi create-npm-dirs",
    "generate-loader": "node ./scripts/generate-loader.mjs",
    "pack:dry-run": "node ./scripts/pack-dry-run.mjs",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test test/*.test.mjs",
    "validate:packages": "node ./scripts/validate-packages.mjs",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.9.0"
  },
  "optionalDependencies": {
    "@opensuitehq/engine-darwin-x64": "0.1.1",
    "@opensuitehq/engine-darwin-arm64": "0.1.1",
    "@opensuitehq/engine-linux-x64-gnu": "0.1.1",
    "@opensuitehq/engine-linux-arm64-gnu": "0.1.1",
    "@opensuitehq/engine-win32-x64-msvc": "0.1.1"
  }
}