{
  "name": "@opensuite/engine",
  "version": "0.1.0",
  "description": "OpenSuite native DOCX engine (N-API). Platform binaries ship as optionalDependencies.",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamshivakhatri/opensuite-engine.git"
  },
  "license": "MIT OR Apache-2.0",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "opensuite_node",
    "packageName": "@opensuite/engine",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --dts index.d.ts",
    "build:debug": "napi build --platform --dts index.d.ts",
    "create-npm-dirs": "napi create-npm-dirs",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test test/*.test.mjs",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.9.0"
  }
}
